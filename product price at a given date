# Write your MySQL query statement below
WITH CTE AS(
    Select product_id,MAX(
        CASE 
          WHEN
            change_date<='2019-08-16'
            THEN change_date
            END) As date
    FROM Products
    GROUP BY product_id
    )

SELECT CTE.product_id,COALESCE(p.new_price,10) AS price
FROM CTE
LEFT JOIN Products AS p
ON CTE.date=p.change_date AND CTE.product_id=p.product_id
